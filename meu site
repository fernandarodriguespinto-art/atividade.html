<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description"
        content="NEXUS — notícias, inteligência artificial, programação, gadgets e inovação.">

    <title>NEXUS — Tech Blog</title>

    <!-- Fonte -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap"
        rel="stylesheet">

    <style>

        /* =========================================================
           RESET
        ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: #05060a;
            color: #f5f7ff;
            font-family: "Inter", sans-serif;
            overflow-x: hidden;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button,
        input {
            font-family: inherit;
        }

        ::selection {
            background: #7c5cff;
            color: white;
        }


        /* =========================================================
           VARIÁVEIS
        ========================================================= */

        :root {
            --purple: #805cff;
            --purple-light: #a78bfa;
            --blue: #20d9ff;
            --pink: #ff4ecd;

            --background: #05060a;
            --surface: #0c0e15;
            --surface-2: #11141d;

            --border: rgba(255,255,255,.09);

            --text: #f7f8ff;
            --muted: #8991a5;

            --max-width: 1250px;
        }


        /* =========================================================
           BACKGROUND
        ========================================================= */

        body::before {
            content: "";
            position: fixed;
            width: 600px;
            height: 600px;
            top: -250px;
            left: -200px;
            background: #613cff;
            opacity: .12;
            filter: blur(150px);
            border-radius: 50%;
            pointer-events: none;
            z-index: -2;
        }

        body::after {
            content: "";
            position: fixed;
            width: 500px;
            height: 500px;
            right: -200px;
            top: 500px;
            background: #00cfff;
            opacity: .08;
            filter: blur(150px);
            border-radius: 50%;
            pointer-events: none;
            z-index: -2;
        }


        /* =========================================================
           HEADER
        ========================================================= */

        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 999;

            background: rgba(5,6,10,.72);
            backdrop-filter: blur(20px);

            border-bottom: 1px solid rgba(255,255,255,.06);
        }

        .navbar {
            max-width: var(--max-width);
            height: 76px;
            margin: auto;

            padding: 0 25px;

            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;

            font-family: "Space Grotesk";
            font-size: 25px;
            font-weight: 700;
            letter-spacing: -1px;
        }

        .logo-icon {
            width: 34px;
            height: 34px;

            display: grid;
            place-items: center;

            border-radius: 10px;

            background: linear-gradient(
                135deg,
                var(--purple),
                var(--blue)
            );

            box-shadow:
                0 0 30px rgba(128,92,255,.35);
        }

        .logo span {
            color: var(--purple-light);
        }

        nav {
            display: flex;
            gap: 32px;
            align-items: center;
        }

        nav a {
            color: #a6adbf;
            font-size: 14px;
            font-weight: 500;
            transition: .3s;
        }

        nav a:hover {
            color: white;
        }

        .header-button {
            padding: 10px 17px;

            border: 1px solid rgba(255,255,255,.1);
            border-radius: 9px;

            background: rgba(255,255,255,.04);

            font-size: 13px;
            font-weight: 600;

            transition: .3s;
        }

        .header-button:hover {
            background: rgba(255,255,255,.08);
            border-color: rgba(255,255,255,.2);
        }


        /* =========================================================
           HERO
        ========================================================= */

        .hero {
            max-width: var(--max-width);
            min-height: 800px;

            margin: auto;
            padding: 150px 25px 80px;

            display: grid;
            grid-template-columns: 1fr 1fr;

            align-items: center;
            gap: 70px;
        }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;

            padding: 8px 13px;

            border: 1px solid rgba(128,92,255,.3);
            border-radius: 50px;

            background: rgba(128,92,255,.08);

            color: #b9a9ff;

            font-size: 12px;
            font-weight: 600;

            margin-bottom: 25px;
        }

        .tag-dot {
            width: 7px;
            height: 7px;

            background: #6effb0;
            border-radius: 50%;

            box-shadow: 0 0 10px #6effb0;
        }

        .hero h1 {
            font-family: "Space Grotesk";

            font-size: clamp(50px, 6vw, 82px);
            line-height: .98;

            letter-spacing: -4px;

            max-width: 700px;

            margin-bottom: 28px;
        }

        .gradient-text {
            background: linear-gradient(
                100deg,
                #9c7cff,
                #24dfff,
                #ff64da
            );

            -webkit-background-clip: text;
            color: transparent;
        }

        .hero-description {
            color: var(--muted);

            max-width: 610px;

            font-size: 17px;
            line-height: 1.8;

            margin-bottom: 35px;
        }

        .hero-actions {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .primary-button {
            display: inline-flex;
            align-items: center;
            gap: 10px;

            padding: 14px 20px;

            border-radius: 10px;

            background: linear-gradient(
                135deg,
                #805cff,
                #5e87ff
            );

            font-weight: 700;
            font-size: 14px;

            box-shadow:
                0 15px 40px rgba(128,92,255,.22);

            transition: .3s;
        }

        .primary-button:hover {
            transform: translateY(-3px);
            box-shadow:
                0 20px 50px rgba(128,92,255,.35);
        }

        .secondary-button {
            padding: 14px 20px;

            border: 1px solid var(--border);
            border-radius: 10px;

            color: #b7bdcd;

            font-size: 14px;
            font-weight: 600;

            transition: .3s;
        }

        .secondary-button:hover {
            color: white;
            background: rgba(255,255,255,.05);
        }


        /* =========================================================
           HERO IMAGE
        ========================================================= */

        .hero-visual {
            position: relative;
        }

        .hero-image {
            width: 100%;
            height: 500px;

            object-fit: cover;

            border-radius: 24px;

            border: 1px solid rgba(255,255,255,.12);

            box-shadow:
                0 40px 100px rgba(0,0,0,.6);

            filter: saturate(1.15);
        }

        .hero-overlay {
            position: absolute;
            inset: 0;

            border-radius: 24px;

            background:
                linear-gradient(
                    180deg,
                    transparent 40%,
                    rgba(5,6,10,.75)
                );
        }

        .floating-card {
            position: absolute;

            left: -35px;
            bottom: 30px;

            width: 245px;

            padding: 18px;

            background: rgba(12,14,21,.9);

            border: 1px solid rgba(255,255,255,.1);

            border-radius: 15px;

            backdrop-filter: blur(15px);

            box-shadow: 0 20px 50px rgba(0,0,0,.4);
        }

        .floating-card small {
            color: #7f879b;
            font-size: 11px;
        }

        .floating-card strong {
            display: block;

            margin-top: 5px;

            font-size: 15px;
            line-height: 1.4;
        }

        .author-row {
            margin-top: 15px;

            display: flex;
            align-items: center;
            gap: 9px;
        }

        .avatar {
            width: 28px;
            height: 28px;

            border-radius: 50%;

            object-fit: cover;
        }

        .author-row span {
            color: #9ba3b6;
            font-size: 11px;
        }


        /* =========================================================
           SECTION
        ========================================================= */

        .section {
            max-width: var(--max-width);

            margin: auto;

            padding: 90px 25px;
        }

        .section-heading {
            display: flex;
            align-items: end;
            justify-content: space-between;

            margin-bottom: 35px;
        }

        .section-heading h2 {
            font-family: "Space Grotesk";

            font-size: 36px;
            letter-spacing: -1.5px;
        }

        .section-heading p {
            color: var(--muted);
            font-size: 14px;
        }


        /* =========================================================
           FEATURED GRID
        ========================================================= */

        .featured-grid {
            display: grid;

            grid-template-columns: 1.4fr .8fr;

            gap: 20px;
        }

        .featured-card {
            position: relative;

            min-height: 480px;

            overflow: hidden;

            border-radius: 20px;

            border: 1px solid var(--border);

            background: var(--surface);
        }

        .featured-card img {
            width: 100%;
            height: 100%;

            min-height: 480px;

            object-fit: cover;

            transition: transform .6s;
        }

        .featured-card:hover img {
            transform: scale(1.04);
        }

        .featured-gradient {
            position: absolute;
            inset: 0;

            background:
                linear-gradient(
                    to top,
                    rgba(4,5,9,.98),
                    rgba(4,5,9,.05) 70%
                );
        }

        .featured-content {
            position: absolute;

            bottom: 0;
            left: 0;

            padding: 35px;

            max-width: 700px;
        }

        .category {
            color: #a78bfa;

            font-size: 11px;
            font-weight: 700;

            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

        .featured-content h3 {
            font-family: "Space Grotesk";

            font-size: 34px;
            line-height: 1.15;

            margin: 10px 0;
        }

        .featured-content p {
            color: #a7afc0;

            font-size: 14px;

            max-width: 570px;
        }

        .small-feature {
            display: flex;
            flex-direction: column;

            min-height: 230px;

            overflow: hidden;

            border-radius: 20px;

            border: 1px solid var(--border);

            background: var(--surface);

            position: relative;
        }

        .small-feature img {
            width: 100%;
            height: 230px;

            object-fit: cover;
        }

        .small-feature-content {
            position: absolute;
            bottom: 0;

            padding: 25px;

            background:
                linear-gradient(
                    transparent,
                    rgba(5,6,10,.98)
                );

            width: 100%;
        }

        .small-feature-content h3 {
            font-family: "Space Grotesk";
            font-size: 20px;
            margin-top: 7px;
        }

        .right-features {
            display: grid;
            gap: 20px;
        }


        /* =========================================================
           POSTS
        ========================================================= */

        .posts-grid {
            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 22px;
        }

        .post {
            overflow: hidden;

            border-radius: 16px;

            border: 1px solid var(--border);

            background: var(--surface);

            transition: .35s;
        }

        .post:hover {
            transform: translateY(-7px);

            border-color:
                rgba(128,92,255,.35);

            box-shadow:
                0 25px 50px rgba(0,0,0,.25);
        }

        .post-image {
            height: 220px;

            overflow: hidden;
        }

        .post-image img {
            width: 100%;
            height: 100%;

            object-fit: cover;

            transition: transform .5s;
        }

        .post:hover img {
            transform: scale(1.06);
        }

        .post-content {
            padding: 23px;
        }

        .post h3 {
            font-family: "Space Grotesk";

            font-size: 21px;
            line-height: 1.3;

            margin: 10px 0;
        }

        .post p {
            color: var(--muted);

            font-size: 13px;
            line-height: 1.7;
        }

        .post-footer {
            margin-top: 20px;

            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .date {
            color: #656d80;
            font-size: 11px;
        }

        .read-more {
            color: #b29fff;
            font-size: 12px;
            font-weight: 700;
        }


        /* =========================================================
           CATEGORIES
        ========================================================= */

        .categories {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .category-button {
            padding: 10px 15px;

            border-radius: 50px;

            border: 1px solid var(--border);

            background: rgba(255,255,255,.025);

            color: #9ca4b8;

            font-size: 12px;

            transition: .3s;
        }

        .category-button:hover,
        .category-button.active {
            color: white;

            border-color:
                rgba(128,92,255,.5);

            background:
                rgba(128,92,255,.12);
        }


        /* =========================================================
           NEWSLETTER
        ========================================================= */

        .newsletter {
            position: relative;

            overflow: hidden;

            padding: 70px 30px;

            border-radius: 25px;

            text-align: center;

            background:
                radial-gradient(
                    circle at 50% 0%,
                    rgba(128,92,255,.25),
                    transparent 55%
                ),
                #0b0d15;

            border: 1px solid var(--border);
        }

        .newsletter h2 {
            font-family: "Space Grotesk";

            font-size: 40px;
            letter-spacing: -1px;

            margin-bottom: 10px;
        }

        .newsletter p {
            color: var(--muted);

            max-width: 500px;

            margin: auto auto 30px;

            font-size: 14px;
        }

        .newsletter-form {
            display: flex;

            justify-content: center;

            max-width: 500px;

            margin: auto;

            gap: 10px;
        }

        .newsletter input {
            flex: 1;

            min-width: 0;

            padding: 14px 16px;

            background: #080a10;

            border: 1px solid var(--border);

            border-radius: 9px;

            outline: none;

            color: white;
        }

        .newsletter input:focus {
            border-color: #7659ef;
        }

        .newsletter button {
            border: none;
            cursor: pointer;
        }


        /* =========================================================
           FOOTER
        ========================================================= */

        footer {
            max-width: var(--max-width);

            margin: auto;

            padding: 50px 25px 30px;

            border-top: 1px solid var(--border);
        }

        .footer-top {
            display: flex;

            justify-content: space-between;

            gap: 40px;

            padding-bottom: 40px;
        }

        .footer-brand {
            max-width: 350px;
        }

        .footer-brand p {
            color: var(--muted);

            margin-top: 15px;

            font-size: 13px;
            line-height: 1.7;
        }

        .socials {
            display: flex;
            gap: 10px;
        }

        .social {
            width: 38px;
            height: 38px;

            display: grid;
            place-items: center;

            border-radius: 9px;

            border: 1px solid var(--border);

            color: #929aad;

            transition: .3s;
        }

        .social:hover {
            color: white;
            background: rgba(255,255,255,.06);
        }

        .copyright {
            color: #555c6e;

            font-size: 11px;

            padding-top: 25px;

            border-top: 1px solid var(--border);
        }


        /* =========================================================
           MOBILE
        ========================================================= */

        @media (max-width: 950px) {

            .hero {
                grid-template-columns: 1fr;

                padding-top: 130px;
            }

            .hero-visual {
                max-width: 700px;
            }

            .featured-grid {
                grid-template-columns: 1fr;
            }

            .posts-grid {
                grid-template-columns:
                    repeat(2, 1fr);
            }
        }

        @media (max-width: 700px) {

            nav {
                display: none;
            }

            .header-button {
                display: none;
            }

            .hero {
                min-height: auto;

                padding-top: 120px;
                padding-bottom: 50px;
            }

            .hero h1 {
                font-size: 52px;
                letter-spacing: -3px;
            }

            .hero-description {
                font-size: 15px;
            }

            .hero-image {
                height: 380px;
            }

            .floating-card {
                left: 15px;
                bottom: 15px;
            }

            .section {
                padding: 65px 20px;
            }

            .section-heading {
                display: block;
            }

            .section-heading h2 {
                font-size: 29px;
                margin-bottom: 7px;
            }

            .posts-grid {
                grid-template-columns: 1fr;
            }

            .featured-content {
                padding: 25px;
            }

            .featured-content h3 {
                font-size: 27px;
            }

            .newsletter {
                padding: 50px 20px;
            }

            .newsletter h2 {
                font-size: 30px;
            }

            .newsletter-form {
                flex-direction: column;
            }

            .newsletter button {
                width: 100%;
            }

            .footer-top {
                flex-direction: column;
            }
        }

    </style>
</head>


